{
  "name": "NDP3 Speech Builder",
  "productName": "NDP3 Speech Builder",
  "version": "2.0.54",
  "description": "NDP3 Speech Builder",
  "main": "src/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:debug": "DEBUG=electron-forge:* electron-forge make",
    "generate-yml": "node scripts/generate-yml.js",
    "upload-yml": "node scripts/upload-yml.js",
    "publish-mac": "electron-forge publish && sleep 5 && npm run generate-yml && npm run upload-yml",
    "publish-win": "electron-forge publish && timeout /t 5 /nobreak && npm run generate-yml && npm run upload-yml",
    "lint": "echo \"No linting configured\""
  },
  "keywords": [],
  "author": {
    "name": "stevenhadcroft",
    "email": "steven@stevenhadcroft.com"
  },
  "license": "MIT",
  "dependencies": {
    "@electron-forge/maker-wix": "^7.8.1",
    "electron-log": "^5.4.2",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.6.2",
    "update-electron-app": "^3.1.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-deb": "^7.8.1",
    "@electron-forge/maker-dmg": "^7.8.1",
    "@electron-forge/maker-rpm": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.2",
    "@electron-forge/plugin-fuses": "^7.8.2",
    "@electron-forge/publisher-github": "^7.8.3",
    "@electron/fuses": "^1.8.0",
    "@electron/notarize": "^3.0.1",
    "dotenv": "^17.2.1",
    "electron": "36.3.1",
    "electron-notarize": "^1.2.2"
  }
}
